{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "node16",
    "target": "es2023",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strictNullChecks": true
  },
  "include": [
    "api/src/**/*.js",
    "ui/widgets/*/data.js",
    "ui/widgets/*/demo.js",
    "docs/widget-template/*.js"
  ],
  "exclude": [
    "docs/widget-template/widget.js"
  ]
}