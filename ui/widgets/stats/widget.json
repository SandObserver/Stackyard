{
  "name": "stats",
  "label": "widget.label",
  "sizes": [
    "small",
    "medium"
  ],
  "viewField": "widgetSubType",
  "defaultView": "system-summary",
  "views": {
    "system-summary": {
      "label": "view.system-summary.label",
      "src": "system-stats.html",
      "card": "dark"
    },
    "disk-health": {
      "label": "view.disk-health.label",
      "src": "disk-health.html"
    }
  },
  "fields": [
    {
      "key": "widgetSubType",
      "type": "select",
      "variant": "pills",
      "label": "widgetSubType.label",
      "default": "system-summary",
      "options": [
        {
          "value": "system-summary",
          "label": "widgetSubType.opt.system-summary"
        },
        {
          "value": "disk-health",
          "label": "widgetSubType.opt.disk-health"
        }
      ]
    },
    {
      "key": "slots",
      "type": "group",
      "label": "slots.label",
      "min": 3,
      "max": 3,
      "showIf": {
        "field": "widgetSubType",
        "equals": "system-summary"
      },
      "fields": [
        {
          "key": "type",
          "type": "select",
          "label": "slots.type.label",
          "default": "cpu",
          "options": [
            {
              "value": "cpu",
              "label": "slots.type.opt.cpu"
            },
            {
              "value": "ram",
              "label": "slots.type.opt.ram"
            },
            {
              "value": "temp",
              "label": "slots.type.opt.temp"
            },
            {
              "value": "disk",
              "label": "slots.type.opt.disk"
            },
            {
              "value": "iowait",
              "label": "slots.type.opt.iowait"
            },
            {
              "value": "procs",
              "label": "slots.type.opt.procs"
            }
          ]
        },
        {
          "key": "primary",
          "type": "text",
          "label": "slots.primary.label",
          "default": "/",
          "placeholder": "slots.primary.placeholder",
          "showIf": {
            "field": "type",
            "equals": "disk"
          }
        },
        {
          "key": "secondary",
          "type": "text",
          "label": "slots.secondary.label",
          "placeholder": "slots.secondary.placeholder",
          "optional": true,
          "showIf": {
            "field": "type",
            "equals": "disk"
          }
        },
        {
          "key": "thermalZone",
          "type": "number",
          "label": "slots.thermalZone.label",
          "default": 0,
          "showIf": {
            "field": "type",
            "equals": "temp"
          }
        },
        {
          "key": "color",
          "type": "color",
          "label": "slots.color.label",
          "default": "#0091FF"
        }
      ]
    },
    {
      "key": "network",
      "type": "object",
      "label": "network.label",
      "showIf": {
        "field": "widgetSubType",
        "equals": "system-summary"
      },
      "fields": [
        {
          "key": "enabled",
          "type": "toggle",
          "label": "network.enabled.label",
          "default": false
        },
        {
          "key": "mode",
          "type": "select",
          "variant": "pills",
          "label": "network.mode.label",
          "default": "speed",
          "showIf": {
            "field": "enabled",
            "equals": true
          },
          "options": [
            {
              "value": "speed",
              "label": "network.mode.opt.speed"
            },
            {
              "value": "throughput",
              "label": "network.mode.opt.throughput"
            },
            {
              "value": "uptime",
              "label": "network.mode.opt.uptime"
            }
          ]
        },
        {
          "key": "provider",
          "type": "select",
          "variant": "pills",
          "label": "network.provider.label",
          "default": "myspeed",
          "showIf": {
            "field": "mode",
            "equals": "speed"
          },
          "options": [
            {
              "value": "myspeed",
              "label": "network.provider.opt.myspeed"
            },
            {
              "value": "speedtest-tracker",
              "label": "network.provider.opt.speedtest-tracker"
            }
          ]
        },
        {
          "key": "url",
          "type": "text",
          "label": "network.url.label",
          "placeholder": "network.url.placeholder",
          "showIf": {
            "field": "mode",
            "equals": "speed"
          }
        },
        {
          "key": "myspeedPass",
          "type": "secret",
          "label": "network.myspeedPass.label",
          "optional": true,
          "showIf": {
            "field": "provider",
            "equals": "myspeed"
          }
        }
      ]
    },
    {
      "key": "diskProvider",
      "type": "select",
      "label": "diskProvider.label",
      "default": "scrutiny",
      "showIf": {
        "field": "widgetSubType",
        "equals": "disk-health"
      },
      "options": [
        {
          "value": "scrutiny",
          "label": "diskProvider.opt.scrutiny"
        },
        {
          "value": "truenas",
          "label": "diskProvider.opt.truenas"
        }
      ]
    },
    {
      "key": "scrutinyUrl",
      "type": "text",
      "label": "scrutinyUrl.label",
      "placeholder": "scrutinyUrl.placeholder",
      "showIf": {
        "field": "diskProvider",
        "equals": "scrutiny"
      }
    },
    {
      "key": "scrutinyHref",
      "type": "text",
      "label": "scrutinyHref.label",
      "placeholder": "scrutinyHref.placeholder",
      "optional": true,
      "showIf": {
        "field": "diskProvider",
        "equals": "scrutiny"
      }
    },
    {
      "key": "truenasUrl",
      "type": "text",
      "label": "truenasUrl.label",
      "placeholder": "truenasUrl.placeholder",
      "showIf": {
        "field": "diskProvider",
        "equals": "truenas"
      }
    },
    {
      "key": "truenasKey",
      "type": "secret",
      "label": "truenasKey.label",
      "showIf": {
        "field": "diskProvider",
        "equals": "truenas"
      }
    },
    {
      "key": "truenasHref",
      "type": "text",
      "label": "truenasHref.label",
      "placeholder": "truenasHref.placeholder",
      "optional": true,
      "showIf": {
        "field": "diskProvider",
        "equals": "truenas"
      }
    },
    {
      "key": "bays",
      "type": "picklist",
      "label": "bays.label",
      "rowLabel": "bays.rowLabel",
      "optionsFrom": "devices",
      "fetchLabel": "bays.fetchLabel",
      "countBySize": {
        "small": 4,
        "medium": 10
      },
      "showIf": {
        "field": "widgetSubType",
        "equals": "disk-health"
      },
      "hint": "bays.hint"
    }
  ]
}
