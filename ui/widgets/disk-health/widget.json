{
  "name": "disk-health",
  "label": "widget.label",
  "description": "widget.description",
  "appearance": "dark",
  "card": "graphite",
  "glyph": "drive",
  "sizes": [
    "small",
    "medium"
  ],
  "fields": [
    {
      "key": "diskProvider",
      "type": "select",
      "label": "diskProvider.label",
      "default": "scrutiny",
      "options": [
        {
          "value": "scrutiny",
          "label": "diskProvider.opt.scrutiny"
        },
        {
          "value": "truenas",
          "label": "diskProvider.opt.truenas"
        },
        {
          "value": "unraid",
          "label": "diskProvider.opt.unraid"
        }
      ]
    },
    {
      "key": "scrutinyUrl",
      "type": "text",
      "label": "scrutinyUrl.label",
      "placeholder": "scrutinyUrl.placeholder",
      "showIf": {
        "field": "diskProvider",
        "equals": "scrutiny"
      }
    },
    {
      "key": "scrutinyToken",
      "type": "secret",
      "label": "scrutinyToken.label",
      "hint": "scrutinyToken.hint",
      "optional": true,
      "showIf": {
        "field": "diskProvider",
        "equals": "scrutiny"
      }
    },
    {
      "key": "scrutinyHref",
      "type": "text",
      "label": "scrutinyHref.label",
      "placeholder": "scrutinyHref.placeholder",
      "hint": "scrutinyHref.hint",
      "optional": true,
      "showIf": {
        "field": "diskProvider",
        "equals": "scrutiny"
      },
      "cosmetic": true
    },
    {
      "key": "truenasUrl",
      "type": "text",
      "label": "truenasUrl.label",
      "placeholder": "truenasUrl.placeholder",
      "showIf": {
        "field": "diskProvider",
        "equals": "truenas"
      }
    },
    {
      "key": "truenasKey",
      "type": "secret",
      "label": "truenasKey.label",
      "showIf": {
        "field": "diskProvider",
        "equals": "truenas"
      }
    },
    {
      "key": "truenasSkipTls",
      "type": "toggle",
      "label": "truenasSkipTls.label",
      "default": false,
      "showIf": {
        "field": "diskProvider",
        "equals": "truenas"
      }
    },
    {
      "key": "truenasHref",
      "type": "text",
      "label": "truenasHref.label",
      "placeholder": "truenasHref.placeholder",
      "hint": "truenasHref.hint",
      "optional": true,
      "showIf": {
        "field": "diskProvider",
        "equals": "truenas"
      },
      "cosmetic": true
    },
    {
      "key": "unraidUrl",
      "type": "text",
      "label": "unraidUrl.label",
      "placeholder": "unraidUrl.placeholder",
      "showIf": {
        "field": "diskProvider",
        "equals": "unraid"
      }
    },
    {
      "key": "unraidApiKey",
      "type": "secret",
      "label": "unraidApiKey.label",
      "hint": "unraidApiKey.hint",
      "showIf": {
        "field": "diskProvider",
        "equals": "unraid"
      }
    },
    {
      "key": "unraidHref",
      "type": "text",
      "label": "unraidHref.label",
      "placeholder": "unraidHref.placeholder",
      "hint": "unraidHref.hint",
      "optional": true,
      "showIf": {
        "field": "diskProvider",
        "equals": "unraid"
      },
      "cosmetic": true
    },
    {
      "key": "bays",
      "type": "picklist",
      "label": "bays.label",
      "rowLabel": "bays.rowLabel",
      "optionsFrom": "devices",
      "fetchLabel": "bays.fetchLabel",
      "countBySize": {
        "small": 4,
        "medium": 10
      },
      "hint": "bays.hint",
      "cosmetic": true
    }
  ]
}
