{
  "name": "github",
  "label": "widget.label",
  "description": "widget.description",
  "glyph": "merge",
  "sizes": [
    "small",
    "medium",
    "large"
  ],
  "card": "translucent",
  "viewField": "githubView",
  "defaultView": "prs",
  "views": {
    "prs": {
      "label": "view.prs.label",
      "src": "pullrequests.html"
    },
    "contributions": {
      "label": "view.contributions.label",
      "src": "contributions.html"
    }
  },
  "fields": [
    {
      "key": "githubService",
      "type": "select",
      "label": "githubService.label",
      "default": "github",
      "options": [
        {
          "value": "github",
          "label": "githubService.opt.github"
        },
        {
          "value": "gitea",
          "label": "githubService.opt.gitea"
        },
        {
          "value": "forgejo",
          "label": "githubService.opt.forgejo"
        },
        {
          "value": "gitlab",
          "label": "githubService.opt.gitlab"
        }
      ]
    },
    {
      "key": "githubUrl",
      "type": "text",
      "label": "githubUrl.label",
      "placeholder": "githubUrl.placeholder",
      "showIf": {
        "field": "githubService",
        "in": [
          "gitea",
          "forgejo",
          "gitlab"
        ]
      }
    },
    {
      "key": "githubView",
      "type": "select",
      "variant": "pills",
      "label": "githubView.label",
      "options": [
        {
          "value": "prs",
          "label": "githubView.opt.prs"
        },
        {
          "value": "contributions",
          "label": "githubView.opt.contributions"
        }
      ],
      "cosmetic": true,
      "showIf": {
        "field": "githubService",
        "in": [
          "github",
          "gitea",
          "forgejo"
        ]
      }
    },
    {
      "key": "githubUser",
      "type": "text",
      "label": "githubUser.label",
      "placeholder": "githubUser.placeholder",
      "cosmetic": true
    },
    {
      "key": "githubToken",
      "type": "secret",
      "label": "githubToken.label",
      "hint": "githubToken.hint",
      "showIf": {
        "field": "githubService",
        "equals": "github"
      }
    },
    {
      "key": "githubToken",
      "type": "secret",
      "label": "githubToken.label",
      "hint": "githubToken.hint.gitea",
      "showIf": {
        "field": "githubService",
        "in": [
          "gitea",
          "forgejo"
        ]
      }
    },
    {
      "key": "githubToken",
      "type": "secret",
      "label": "githubToken.label",
      "hint": "githubToken.hint.gitlab",
      "showIf": {
        "field": "githubService",
        "equals": "gitlab"
      }
    },
    {
      "key": "githubHref",
      "type": "text",
      "label": "githubHref.label",
      "optional": true,
      "hint": "githubHref.hint",
      "cosmetic": true
    },
    {
      "key": "githubPrFilters",
      "type": "multiselect",
      "label": "githubPrFilters.label",
      "default": [
        "created"
      ],
      "showIf": {
        "field": "githubView",
        "equals": "prs"
      },
      "hint": "githubPrFilters.hint",
      "options": [
        {
          "value": "created",
          "label": "githubPrFilters.opt.created"
        },
        {
          "value": "assigned",
          "label": "githubPrFilters.opt.assigned"
        },
        {
          "value": "mentioned",
          "label": "githubPrFilters.opt.mentioned"
        },
        {
          "value": "review-requested",
          "label": "githubPrFilters.opt.review-requested"
        }
      ],
      "cosmetic": true
    },
    {
      "key": "githubPrFilters",
      "type": "multiselect",
      "label": "githubPrFilters.label.gitlab",
      "default": [
        "created"
      ],
      "showIf": {
        "field": "githubService",
        "equals": "gitlab"
      },
      "hint": "githubPrFilters.hint.gitlab",
      "options": [
        {
          "value": "created",
          "label": "githubPrFilters.opt.created"
        },
        {
          "value": "assigned",
          "label": "githubPrFilters.opt.assigned"
        },
        {
          "value": "review-requested",
          "label": "githubPrFilters.opt.review-requested"
        }
      ],
      "cosmetic": true
    }
  ]
}
