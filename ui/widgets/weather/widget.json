{
  "name": "weather",
  "label": "widget.label",
  "glyph": "weather",
  "sizes": [
    "small"
  ],
  "fields": [
    {
      "key": "provider",
      "type": "select",
      "variant": "pills",
      "label": "provider.label",
      "default": "openmeteo",
      "options": [
        {
          "value": "openmeteo",
          "label": "provider.opt.openmeteo"
        },
        {
          "value": "openweather",
          "label": "provider.opt.openweather"
        }
      ]
    },
    {
      "key": "owKey",
      "type": "secret",
      "label": "owKey.label",
      "hint": "owKey.hint",
      "showIf": {
        "field": "provider",
        "equals": "openweather"
      }
    },
    {
      "key": "cityQuery",
      "type": "text",
      "label": "cityQuery.label",
      "placeholder": "cityQuery.placeholder",
      "optional": true,
      "transient": true
    },
    {
      "key": "city",
      "type": "select",
      "label": "city.label",
      "optionsFrom": "geocode",
      "carries": [
        "lat",
        "lon"
      ],
      "hint": "city.hint"
    },
    {
      "key": "units",
      "type": "select",
      "variant": "pills",
      "label": "units.label",
      "default": "c",
      "options": [
        {
          "value": "c",
          "label": "units.opt.c"
        },
        {
          "value": "f",
          "label": "units.opt.f"
        }
      ]
    },
    {
      "key": "feelsLike",
      "type": "toggle",
      "label": "feelsLike.label",
      "default": false
    },
    {
      "key": "href",
      "type": "text",
      "label": "href.label",
      "placeholder": "href.placeholder",
      "optional": true
    }
  ]
}
