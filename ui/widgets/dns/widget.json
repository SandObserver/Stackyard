{
  "name": "dns",
  "label": "widget.label",
  "sizes": [
    "small",
    "medium"
  ],
  "card": "translucent",
  "fields": [
    {
      "key": "provider",
      "type": "select",
      "variant": "pills",
      "label": "provider.label",
      "options": [
        {
          "value": "adguard",
          "label": "provider.opt.adguard"
        },
        {
          "value": "pihole",
          "label": "provider.opt.pihole"
        },
        {
          "value": "technitium",
          "label": "provider.opt.technitium"
        },
        {
          "value": "nextdns",
          "label": "provider.opt.nextdns"
        }
      ]
    },
    {
      "key": "dnsUrl",
      "type": "text",
      "label": "dnsUrl.label",
      "placeholder": "dnsUrl.placeholder",
      "showIf": {
        "field": "provider",
        "in": [
          "adguard",
          "pihole",
          "technitium"
        ]
      },
      "hint": "dnsUrl.hint"
    },
    {
      "key": "dnsHref",
      "type": "text",
      "label": "dnsHref.label",
      "optional": true,
      "hint": "dnsHref.hint"
    },
    {
      "key": "dnsUser",
      "type": "text",
      "label": "dnsUser.label",
      "optional": true,
      "showIf": {
        "field": "provider",
        "equals": "adguard"
      }
    },
    {
      "key": "dnsPass",
      "type": "secret",
      "label": "dnsPass.label",
      "optional": true,
      "showIf": {
        "field": "provider",
        "equals": "adguard"
      }
    },
    {
      "key": "dnsPiholePassword",
      "type": "secret",
      "label": "dnsPiholePassword.label",
      "optional": true,
      "showIf": {
        "field": "provider",
        "equals": "pihole"
      },
      "hint": "dnsPiholePassword.hint"
    },
    {
      "key": "dnsTechnitiumToken",
      "type": "secret",
      "label": "dnsTechnitiumToken.label",
      "showIf": {
        "field": "provider",
        "equals": "technitium"
      },
      "hint": "dnsTechnitiumToken.hint"
    },
    {
      "key": "dnsNextdnsApiKey",
      "type": "secret",
      "label": "dnsNextdnsApiKey.label",
      "showIf": {
        "field": "provider",
        "equals": "nextdns"
      },
      "hint": "dnsNextdnsApiKey.hint"
    },
    {
      "key": "dnsNextdnsProfile",
      "type": "text",
      "label": "dnsNextdnsProfile.label",
      "placeholder": "dnsNextdnsProfile.placeholder",
      "showIf": {
        "field": "provider",
        "equals": "nextdns"
      },
      "hint": "dnsNextdnsProfile.hint"
    }
  ]
}
