{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "api/src/**/*.js",
      "ui/js/**/*.js",
      "ui/widgets/**/*.js",
      "scripts/**/*.js",
      "docs/widget-template/**/*.js",
      "e2e/**/*.js",
      "playwright.config.js",
      "api/test/**/*.js",
      "api/test-support/**/*.js",
      "ui/test/**/*.mjs",
      "test/repo/**/*.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredVariables": "error"
      },
      "style": {
        "useTemplate": "off",
        "useNodejsImportProtocol": "off"
      },
      "complexity": {
        "useOptionalChain": "off",
        "useLiteralKeys": "off",
        "useArrowFunction": "off"
      },
      "suspicious": {
        "noShadow": "error",
        "useIterableCallbackReturn": "off"
      },
      "performance": {
        "useDomNodeTextContent": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["ui/js/**/*.js"],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "error"
          }
        }
      }
    },
    {
      "includes": ["api/test/**/*.js", "api/test-support/**/*.js", "ui/test/**/*.mjs", "test/repo/**/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off",
            "noRedundantUseStrict": "off",
            "noTemplateCurlyInString": "off"
          },
          "security": {
            "noGlobalEval": "off"
          },
          "complexity": {
            "noCommaOperator": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    },
    {
      "includes": [
        "ui/widgets/backup/backup.js",
        "ui/widgets/books/widget.js",
        "ui/widgets/clock/analog.js",
        "ui/widgets/clock/captain.js",
        "ui/widgets/clock/digital.js",
        "ui/widgets/connections/connections-map.js",
        "ui/widgets/connections/connections-vpn.js",
        "ui/widgets/dashboard-switch/widget.js",
        "ui/widgets/disk-health/widget.js",
        "ui/widgets/dns/widget.js",
        "ui/widgets/downloads/widget.js",
        "ui/widgets/github/contributions.js",
        "ui/widgets/github/pullrequests.js",
        "ui/widgets/nowplaying/widget.js",
        "ui/widgets/system-summary/widget.js",
        "ui/widgets/upnext/widget.js",
        "ui/widgets/weather/widget.js"
      ],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "complexity": { "noCommaOperator": "off" },
          "correctness": { "noUnusedVariables": "off", "usePlaywrightValidDescribeCallback": "off" },
          "style": { "useConst": "off" },
          "suspicious": { "noGlobalIsFinite": "off", "noGlobalIsNan": "off", "noShadow": "off", "noSparseArray": "off" }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "asNeeded"
    }
  }
}
