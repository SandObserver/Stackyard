{
  "_schemaVersion": 1,
  "settings": {
    "background": {
      "type": "url",
      "url": "/demo-wallpaper.jpg",
      "brightness": 0.4
    },
    "auth": {
      "enabled": false,
      "setupPrompted": true
    },
    "logLevel": "info",
    "language": "en"
  },
  "items": [
    {
      "id": "app-jellyfin",
      "type": "app",
      "label": "Jellyfin",
      "href": "https://media.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/jellyfin-light.svg",
      "dock": true,
      "monitoring": {
        "activity": {
          "enabled": true,
          "interval": 30
        }
      },
      "color": "#6D4AA8"
    },
    {
      "id": "app-portainer",
      "type": "app",
      "label": "Portainer",
      "href": "https://containers.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/portainer-dark.svg",
      "dock": true,
      "monitoring": {
        "activity": {
          "enabled": true,
          "interval": 30
        }
      },
      "color": "dark"
    },
    {
      "id": "app-hass",
      "type": "app",
      "label": "Home Assistant",
      "href": "https://home.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/home-assistant-light.svg",
      "dock": true,
      "color": "#18BCF2"
    },
    {
      "id": "app-vaultwarden",
      "type": "app",
      "label": "Vaultwarden",
      "href": "https://vault.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/vaultwarden-light.svg",
      "dock": true,
      "color": "#175DDC"
    },
    {
      "id": "w-clock",
      "type": "widget",
      "widgetType": "clock",
      "label": "Clock",
      "widgetSize": "small",
      "widgetConfig": {
        "clockStyle": "analog",
        "clockMode": "dark",
        "clockTimezone": "America/Los_Angeles",
        "clockShowDate": true
      }
    },
    {
      "id": "w-weather",
      "type": "widget",
      "widgetType": "weather",
      "label": "Weather",
      "widgetSize": "small",
      "widgetConfig": {
        "city": "San Francisco, California, USA",
        "lat": 37.7749,
        "lon": -122.4194,
        "units": "c",
        "feelsLike": true
      }
    },
    {
      "id": "w-nowplaying",
      "type": "widget",
      "widgetType": "nowplaying",
      "label": "Now Playing",
      "widgetSize": "small",
      "widgetConfig": {
        "provider": "jellyfin",
        "jellyfinUrl": "https://media.example.com",
        "href": "https://media.example.com"
      }
    },
    {
      "id": "folder-media",
      "type": "folder",
      "label": "Media",
      "children": [
        "app-sonarr",
        "app-radarr",
        "app-tautulli",
        "app-prowlarr"
      ]
    },
    {
      "id": "app-immich",
      "type": "app",
      "label": "Immich",
      "href": "https://photos.example.com",
      "iconUrl": "immich",
      "color": "dark"
    },
    {
      "id": "app-homebridge",
      "type": "app",
      "label": "Homebridge",
      "href": "https://bridge.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/homebridge-light.svg",
      "color": "#4A2E6B"
    },
    {
      "id": "w-stats",
      "type": "widget",
      "widgetType": "system-summary",
      "label": "System",
      "widgetSize": "medium",
      "widgetConfig": {
        "slots": [
          {
            "type": "cpu"
          },
          {
            "type": "ram"
          },
          {
            "type": "disk",
            "primary": "/",
            "secondary": "/mnt/media"
          }
        ],
        "network": {
          "enabled": true,
          "mode": "throughput",
          "provider": "system",
          "interface": "eth0"
        }
      }
    },
    {
      "id": "app-paperless",
      "type": "app",
      "label": "Paperless",
      "href": "https://docs.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/paperless-ngx.svg",
      "color": "light"
    },
    {
      "id": "app-seerr",
      "type": "app",
      "label": "Seerr",
      "href": "https://requests.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/seerr-light.svg",
      "monitoring": {
        "activity": {
          "enabled": true,
          "interval": 30
        }
      },
      "color": "#6E28DA"
    },
    {
      "id": "app-grafana",
      "type": "app",
      "label": "Grafana",
      "href": "https://metrics.example.com",
      "iconUrl": "grafana",
      "monitoring": {
        "healthcheck": {
          "enabled": true,
          "pingUrl": "https://metrics.example.com"
        }
      },
      "color": "dark"
    },
    {
      "id": "app-adguard",
      "type": "app",
      "label": "AdGuard",
      "href": "https://dns.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/adguard-home-light.svg",
      "color": "#68B379"
    },
    {
      "id": "w-dns",
      "type": "widget",
      "widgetType": "dns",
      "label": "Pi-hole",
      "widgetSize": "small",
      "widgetConfig": {
        "provider": "pihole",
        "dnsUrl": "https://dns.example.com"
      }
    },
    {
      "id": "w-switch",
      "type": "widget",
      "widgetType": "dashboard-switch",
      "label": "Dashboards",
      "widgetSize": "small",
      "widgetConfig": {
        "keychains": [
          {
            "label": "Home",
            "url": "https://home.example.com"
          },
          {
            "label": "Lab",
            "url": "https://lab.example.com"
          }
        ],
        "openIn": "same"
      }
    },
    {
      "id": "app-uptimekuma",
      "type": "app",
      "label": "Uptime Kuma",
      "href": "https://status.example.com",
      "iconUrl": "uptime-kuma",
      "color": "dark"
    },
    {
      "id": "app-proxmox",
      "type": "app",
      "label": "Proxmox",
      "href": "https://hypervisor.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/proxmox-light.svg",
      "color": "#E57000"
    },
    {
      "id": "app-npm",
      "type": "app",
      "label": "Proxy",
      "href": "https://proxy.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/nginx-proxy-manager.svg",
      "color": "dark"
    },
    {
      "id": "app-gitea",
      "type": "app",
      "label": "Gitea",
      "href": "https://git.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/gitea-light.svg",
      "color": "dark"
    },
    {
      "id": "app-mealie",
      "type": "app",
      "label": "Mealie",
      "href": "https://recipes.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/mealie-light.svg",
      "color": "#E58325"
    },
    {
      "id": "app-frigate",
      "type": "app",
      "label": "Frigate",
      "href": "https://cameras.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/frigate-light.svg",
      "color": "#2167BC"
    },
    {
      "id": "app-syncthing",
      "type": "app",
      "label": "Syncthing",
      "href": "https://sync.example.com",
      "iconUrl": "syncthing",
      "color": "dark"
    },
    {
      "id": "app-authelia",
      "type": "app",
      "label": "Authelia",
      "href": "https://auth.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/authelia-light.svg",
      "color": "#2F3FA6"
    },
    {
      "id": "folder-downloads",
      "type": "folder",
      "label": "Downloads",
      "children": [
        "app-qbittorrent",
        "app-sabnzbd"
      ]
    },
    {
      "id": "app-sonarr",
      "type": "app",
      "label": "Sonarr",
      "href": "https://tv.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/sonarr.svg",
      "color": "dark"
    },
    {
      "id": "app-radarr",
      "type": "app",
      "label": "Radarr",
      "href": "https://movies.example.com",
      "iconUrl": "radarr",
      "color": "dark"
    },
    {
      "id": "app-tautulli",
      "type": "app",
      "label": "Tautulli",
      "href": "https://stats.example.com",
      "iconUrl": "tautulli",
      "color": "dark"
    },
    {
      "id": "app-prowlarr",
      "type": "app",
      "label": "Prowlarr",
      "href": "https://indexers.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/prowlarr-light.svg",
      "color": "#E66001"
    },
    {
      "id": "app-qbittorrent",
      "type": "app",
      "label": "qBittorrent",
      "href": "https://torrents.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/qbittorrent-light.svg",
      "color": "dark"
    },
    {
      "id": "app-sabnzbd",
      "type": "app",
      "label": "SABnzbd",
      "href": "https://usenet.example.com",
      "iconUrl": "sabnzbd",
      "color": "dark"
    }
  ]
}
