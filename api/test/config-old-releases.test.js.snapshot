    },
    "auth": {
      "enabled": false,
      "setupPrompted": true
    },
    "logLevel": "info",
    "language": "en"
  },
  "items": [
    {
      "id": "app-jellyfin",
      "type": "app",
      "label": "Jellyfin",
      "href": "https://media.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/jellyfin-light.svg",
      "dock": true,
      "monitoring": {
        "activity": {
          "enabled": true,
          "interval": 30
        }
      },
      "color": "#6D4AA8"
    },
    {
      "id": "app-portainer",
      "type": "app",
      "label": "Portainer",
      "href": "https://containers.example.com",
      "iconUrl": "portainer-dark",
      "dock": true,
      "monitoring": {
        "activity": {
          "enabled": true,
          "interval": 30
        }
      },
      "color": "dark"
    },
    {
      "id": "app-hass",
      "type": "app",
      "label": "Home Assistant",
      "href": "https://home.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/home-assistant-light.svg",
      "dock": true,
      "color": "#18BCF2"
    },
    {
      "id": "app-vaultwarden",
      "type": "app",
      "label": "Vaultwarden",
      "href": "https://vault.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/vaultwarden-light.svg",
      "dock": true,
      "color": "#175DDC"
    },
    {
      "id": "w-clock",
      "type": "widget",
      "widgetType": "clock",
      "label": "Clock",
      "widgetSize": "small",
      "widgetConfig": {
        "clockStyle": "analog",
        "clockTimezone": "America/Los_Angeles",
        "clockShowDate": true
      }
    },
    {
      "id": "w-weather",
      "type": "widget",
      "widgetType": "weather",
      "label": "Weather",
      "widgetSize": "small",
      "widgetConfig": {
        "city": "San Francisco, California, USA",
        "lat": 37.7749,
        "lon": -122.4194,
        "units": "c",
        "feelsLike": true
      }
    },
    {
      "id": "w-nowplaying",
      "type": "widget",
      "widgetType": "nowplaying",
      "label": "Now Playing",
      "widgetSize": "small",
      "widgetConfig": {
        "provider": "jellyfin",
        "jellyfinUrl": "https://media.example.com",
        "href": "https://media.example.com"
      }
    },
    {
      "id": "folder-media",
      "type": "folder",
      "label": "Media",
      "children": [
        "app-sonarr",
        "app-radarr",
        "app-tautulli",
        "app-prowlarr"
      ]
    },
    {
      "id": "app-immich",
      "type": "app",
      "label": "Immich",
      "href": "https://photos.example.com",
      "iconUrl": "immich",
      "color": "dark"
    },
    {
      "id": "app-homebridge",
      "type": "app",
      "label": "Homebridge",
      "href": "https://bridge.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/homebridge-light.svg",
      "color": "#4A2E6B"
    },
    {
      "id": "w-stats",
      "type": "widget",
      "widgetType": "system-summary",
      "label": "System",
      "widgetSize": "medium",
      "widgetConfig": {
        "slots": [
          {
            "type": "cpu"
          },
          {
            "type": "ram"
          },
          {
            "type": "disk",
            "primary": "/",
            "secondary": "/mnt/media"
          }
        ],
        "network": {
          "enabled": true,
          "mode": "speed",
          "provider": "myspeed"
        }
      }
    },
    {
      "id": "app-paperless",
      "type": "app",
      "label": "Paperless",
      "href": "https://docs.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/paperless-ngx.svg",
      "color": "light"
    },
    {
      "id": "app-seerr",
      "type": "app",
      "label": "Seerr",
      "href": "https://requests.example.com",
      "iconUrl": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/seerr-light.svg",
      "monitoring": {
        "activity": {
          "enabled": true,
          "interval": 30
        }
      },
      "color": "#6E28DA"
    },
    {
      "id": "app-grafana",
      "type": "app",
      "label": "Grafana",
      "href": "https://metrics.example.com",
      "iconUrl": "grafana",
      "monitoring": {
