/* A real typecheck of the frontend. checkJs is on, so every module under ui/js
   is checked against its JSDoc and against the DOM lib, and this project is
   also what resolves the cache-busted import specifiers (/js/foo.js?v=hash)
   back to real files. A missing paths entry is a build failure rather than a
   silently broken editor.

   Every file needs two entries, plain and ?v=*, because TypeScript allows at
   most one wildcard per pattern (TS5061), so the two forms cannot be globbed
   into one. Add both when you add a module under ui/js.

   strict stays off deliberately. The value here is the errors that are real
   bugs (a name used before it is defined, a misspelled identifier, a property
   that does not exist on the type), not exhaustive null-tracking through
   hand-written DOM code. */
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "paths": {
      "/js/admin-app-form.js": [
        "./ui/js/admin-app-form.js"
      ],
      "/js/admin-app-form.js?v=*": [
        "./ui/js/admin-app-form.js"
      ],
      "/js/admin-auth.js": [
        "./ui/js/admin-auth.js"
      ],
