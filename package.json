{
  "name": "stackyard-dev",
  "private": true,
  "description": "Dev-only tooling (lint, backend typecheck, frontend path resolution). Not shipped: the Docker image copies only api/ and ui/, never the repo root.",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "warn"
    }
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "paths:check": "node scripts/check-frontend-paths.js",
    "test": "(cd api && npm test) && (cd ui/test && node --test) && (cd test/repo && node --test)",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck:ui": "node node_modules/typescript/bin/tsc -p tsconfig.frontend.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "26.6.6",
    "@typescript/typescript6": "6.0.2",
    "c8": "12.0.0",
    "js-yaml": "^5.5.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
